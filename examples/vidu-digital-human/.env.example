# Development-only convenience file. For the integrated product, put these
# values in the main Gateway config.env shown by `qwenaudio config`.
# DashScope / qwen-audio-agent (same as other examples)
DASHSCOPE_API_KEY=

# Vidu 开放平台 API Key（仅服务端，不要放进浏览器）
VIDU_API_KEY=vda_xxx
# 国内 api.vidu.cn；海外 api.vidu.com
VIDU_API_HOST=api.vidu.cn
VIDU_MODEL=vidu-s2
VIDU_PERSONA_ID=default
VIDU_PERSONA_LABEL=Vidu Avatar
# 当前 Vidu Live 文档的组件版创建路径；旧账号可改为 /live/v1/external-lives
VIDU_CREATE_PATH=/live/s_avatar/component
# WebSocket 路径通常保持默认；可按账号接口版本覆盖
VIDU_STREAM_PATH=/live/v1/external-lives/{liveId}/stream
# Legacy deployments only: put client_secret in the WS query (default 0 keeps it server-side)
VIDU_WS_CLIENT_SECRET=0

# 数字人形象：image_uri 与 avatar_id 二选一
VIDU_AVATAR_IMAGE_URI=https://example.com/avatar.jpg
# VIDU_AVATAR_ID=

# 组件版：Vidu 会推流到你自己的 RTC 频道（artc / trtc / agora / volcengine）
VIDU_RTC_PROVIDER=artc
VIDU_RTC_CHANNEL_ID=
VIDU_RTC_USER_ID=
VIDU_RTC_TOKEN=
# VIDU_RTC_APP_ID=

# 可选：服务端 RTC SDK 桥接模块，导出 openViduRtcBridge()
# 不填时仍可启动纯语音基线，但数字人输出不会被声明为可用
# VIDU_RTC_BRIDGE_MODULE=./rtc-bridge.mjs
